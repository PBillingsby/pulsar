DATABASE_URL=postgresql://user:password@ep-your-endpoint-pooler.region.aws.neon.tech/neondb?sslmode=require&pgbouncer=true
RESEND_API_KEY=re_your_key
ANTHROPIC_API_KEY=sk-ant-your_key
PORT=3001

# Base URL of the web app, used in deletion-confirmation links
APP_URL=http://localhost:3000

# Set to true only behind a proxy that overwrites X-Forwarded-For (Railway, Fly, Cloudflare)
TRUST_PROXY=false

# Log the facts passed to the LLM for each digest
PULSAR_DEBUG=false

# Recipient for src/scripts/dev/test-email.ts
TEST_EMAIL=you@example.com