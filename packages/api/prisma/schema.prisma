generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Event {
  id         String   @id @default(cuid())
  type       String
  sessionId  String
  projectKey String
  url        String
  referrer   String?
  timestamp  DateTime
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([projectKey])
  @@index([sessionId])
  @@index([projectKey, timestamp])
}

model Session {
  id         String   @id
  projectKey String
  firstSeen  DateTime @default(now())
  lastSeen   DateTime @updatedAt
  pageViews  Int      @default(0)
  returned   Boolean  @default(false)

  @@index([projectKey])
}

model Project {
  id          String   @id @default(cuid())
  projectKey  String   @unique
  name        String
  email       String
  domain      String?  @unique
  beta        Boolean  @default(true)
  language    String   @default("English")
  digestDay   Int      @default(1)   // 0=Sunday, 1=Monday
  digestHour  Int      @default(8)   // UTC hour
  betaCode    String?
  plan  String  @default("beta")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?
  termsAcceptedAt DateTime?

  @@index([projectKey])
  @@index([email])
  @@index([digestDay, digestHour])
}

model ProjectAlert {
  id          String    @id @default(cuid())
  projectKey  String
  type        String
  message     String
  windowStart DateTime
  windowEnd   DateTime
  sentAt      DateTime  @default(now())
  resolvedAt  DateTime?
  createdAt   DateTime  @default(now())

  @@index([projectKey, type, sentAt])
}

model ProjectDeletionToken {
  id         String    @id @default(cuid())
  token      String    @unique
  projectKey String
  email      String
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime  @default(now())

  @@index([projectKey])
  @@index([email])
}

model WeeklySnapshot {
  id                  String   @id @default(cuid())
  projectKey          String
  weekStart           DateTime
  totalVisitors       Int
  returning           Int
  comebackRate        Float?
  topPage             String?
  totalEvents         Int
  digestSentAt DateTime?

  // behavioral pattern fields
  activationPage      String?
  avgDepthReturners   Float?
  avgDepthBouncers    Float?
  returnerTopPage     String?
  bouncerTopPage      String?
  returnerFirstPage   String?
  avgSessionDurationReturners Float?
  avgSessionDurationBouncers  Float?
  rageClickCount              Int?
  formSubmissionRate          Float?

  // funnel completion fields
  activationReachRate Float?
  activationPageViews Int?

  createdAt           DateTime @default(now())

  @@unique([projectKey, weekStart])
  @@index([projectKey])
}

model DigestFailure {
  id         String   @id @default(cuid())
  projectKey String
  email      String
  reason     String
  attempts   Int      @default(1)
  resolved   Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([projectKey])
  @@index([resolved])
}

model BetaCode {
  id          String   @id @default(cuid())
  code        String   @unique
  description String?
  usedCount   Int      @default(0)
  maxUses     Int      @default(10)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
}